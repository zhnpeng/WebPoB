{
  "name": "webpob",
  "private": true,
  "version": "0.3.0",
  "description": "Open-source bilingual (EN/ZH) pure-TypeScript Web port of Path of Building for Path of Exile 1 & 2",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @webpob/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "sync:data": "tsx scripts/sync-data/src/index.ts",
    "sync:lua": "tsx scripts/sync-data/src/exportFromLua.ts",
    "oracle:generate": "tsx scripts/oracle-diff/src/generate.ts",
    "oracle:diff": "tsx scripts/oracle-diff/src/diff.ts",
    "test:e2e:ninja": "node scripts/verify-ninja-e2e.mjs",
    "release:status": "node scripts/release.mjs status",
    "release:smoke": "node scripts/release.mjs smoke",
    "release:preview": "node scripts/release.mjs deploy --preview",
    "release:deploy": "node scripts/release.mjs deploy",
    "release:rollback": "node scripts/release.mjs rollback"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
