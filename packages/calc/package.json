{
  "name": "@webpob/calc",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./lite": {
      "types": "./src/lite.ts",
      "import": "./src/lite.ts",
      "default": "./dist/lite.js"
    }
  },
  "dependencies": {
    "@webpob/core": "workspace:*",
    "@webpob/data": "workspace:*",
    "@webpob/i18n": "workspace:*"
  },
  "devDependencies": {
    "@webpob/codec": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
